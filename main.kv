<Home>
    BoxLayout:
        orientation:'vertical'
        BoxLayout:
            orientation:'vertical'
            Label:
                id: affiche
                text:"0"
        BoxLayout:
            orientation:'horizontal'
            Button:
                text: '+'
                on_press: app.function_add("+")
            Button:
                text: '-'
                on_press: app.function_add("-")
            Button:
                text: '*'
                on_press: app.function_add("*")
            Button:
                text: '/'
                on_press: app.function_add("/")
        BoxLayout:
            orientation:'horizontal'
            Button:
                text: '1'
                on_press: app.function_add(1)
            Button:
                text: '2'
                on_press: app.function_add(2)
            Button:
                text: '3'
                on_press: app.function_add(3)
        BoxLayout:
            Button:
                text: '4'
                on_press: app.function_add(4)
            Button:
                text: '5'
                on_press: app.function_add(5)
            Button:
                text: '6'
                on_press: app.function_add(6)
        BoxLayout:
            Button:
                text: '7'
                on_press: app.function_add(7)
            Button:
                text: '8'
                on_press: app.function_add(8)
            Button:
                text: '9'
                on_press: app.function_add(9)
        BoxLayout:
            Button:
                text: '0'
                on_press: app.function_add(0)
            Button:
                text: '='
                on_press: app.function_add("=")